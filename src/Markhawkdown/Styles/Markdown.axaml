<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia">
    <Styles.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="MonospaceFont">JetBrains Mono, Cascadia Code, Consolas, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ColorTextBlock defaults inline code to "consolas", which crashes text shaping where it is not installed. -->
    <Style Selector="ctb|CCode">
        <Setter Property="MonospaceFontFamily" Value="{StaticResource MonospaceFont}" />
    </Style>

    <Style Selector="Border.Toolbar">
        <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.StatusBar">
        <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.StatusBar TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Panes stay transparent so the tinted SukiUI window background shows through, like in the rest of the UI. -->
    <Style Selector="Border.Pane">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.Tool">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Separator.ToolSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Background" Value="{DynamicResource SukiBorderBrush}" />
    </Style>

    <Style Selector="Button.TabClose">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
